rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "giantjamez@gmail.com";
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Every update rule below also checks that userId is unchanged, so a
    // signed-in user can never reassign one of their own docs to another uid.

    match /accounts/{docId} {
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
      allow read, delete: if isAdmin() || isOwner(resource.data.userId);
      allow update: if (isAdmin() || isOwner(resource.data.userId))
        && request.resource.data.userId == resource.data.userId;
    }

    match /characters/{docId} {
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
      allow read, delete: if isAdmin() || isOwner(resource.data.userId);
      allow update: if (isAdmin() || isOwner(resource.data.userId))
        && request.resource.data.userId == resource.data.userId;
    }

    match /raidStatuses/{docId} {
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
      allow read, delete: if isAdmin() || isOwner(resource.data.userId);
      allow update: if (isAdmin() || isOwner(resource.data.userId))
        && request.resource.data.userId == resource.data.userId;
    }

    match /lootItems/{docId} {
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
      allow read, delete: if isAdmin() || isOwner(resource.data.userId);
      allow update: if (isAdmin() || isOwner(resource.data.userId))
        && request.resource.data.userId == resource.data.userId;
    }

    match /shoppingProfiles/{docId} {
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
      allow read, delete: if isAdmin() || isOwner(resource.data.userId);
      allow update: if (isAdmin() || isOwner(resource.data.userId))
        && request.resource.data.userId == resource.data.userId;
    }

    match /buffProfiles/{docId} {
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
      allow read, delete: if isAdmin() || isOwner(resource.data.userId);
      allow update: if (isAdmin() || isOwner(resource.data.userId))
        && request.resource.data.userId == resource.data.userId;
    }

    match /inventoryItems/{docId} {
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
      allow read, delete: if isAdmin() || isOwner(resource.data.userId);
      allow update: if (isAdmin() || isOwner(resource.data.userId))
        && request.resource.data.userId == resource.data.userId;
    }

    match /inventorySnapshots/{uid} {
      allow create, update: if isAdmin()
        || (isOwner(uid) && request.resource.data.userId == uid);
      allow read, delete: if isAdmin() || isOwner(uid);
    }
  }
}
